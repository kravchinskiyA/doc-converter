{
  "name": "doc-converter",
  "version": "0.1.0",
  "private": true,
  "description": "SaaS document and image converter monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @doc-converter/web",
    "dev:api": "npm run dev -w @doc-converter/api",
    "dev:worker": "npm run dev -w @doc-converter/worker",
    "dev:maintenance": "npm run dev -w @doc-converter/maintenance",
    "build": "npm run --workspaces --if-present build",
    "typecheck": "npm run --workspaces --if-present typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.4.5",
    "eslint": "^10.14.0",
    "eslint-plugin-boundaries": "^7.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.1"
  }
}
